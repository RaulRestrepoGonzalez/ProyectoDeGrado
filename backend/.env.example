# Backend - MusicApp Valledupar
PORT=3000
NODE_ENV=development

# MongoDB (PRODUCCIÓN EN Render + DESARROLLO LOCAL)
# Producción (Render): Usa MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/musicapp?retryWrites=true&w=majority

# Desarrollo local: MongoDB local
# MONGODB_URI=mongodb://localhost:27017/soundupar_db

JWT_SECRET=your_jwt_secret_here_change_in_production
CLIENT_ORIGIN=http://localhost:3000

# Socket.IO
SOCKET_PORT=4000
SOCKET_PATH=/socket.io

# === ALMACENAMIENTO DE ARCHIVOS ===
# Los archivos (videos, imágenes, audios) se almacenan directamente en MongoDB GridFS
# Esto significa que NO necesitas Cloudinary, Firebase, o S3
# Los archivos están respaldados en MongoDB Atlas automáticamente
# 
# En Render, simplemente asegúrate de que MONGODB_URI esté configurado
# Los archivos se descargarán desde /api/files/download/:fileId

